<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ShootCounter.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ShootCounter"
    xmlns:views="clr-namespace:ShootCounter.Views"
    xmlns:icons="clr-namespace:ShootCounter.Services"
    Title="ShootCounter"
    Shell.FlyoutBehavior="Disabled">


    <TabBar>
        <ShellContent Title="About" ContentTemplate="{DataTemplate views:AboutPage}">
            <ShellContent.Icon>
                <FontImageSource
                    Glyph="{x:Static icons:IconFont.InformationOutline}"
                    FontFamily="IconFont"
                    Size="24"
                    Color="DarkSlateGray" />
            </ShellContent.Icon>
        </ShellContent>
        <ShellContent Title="Shootings" ContentTemplate="{DataTemplate views:ShootingsPage}">
            <ShellContent.Icon>
                <FontImageSource
                    Glyph="{x:Static icons:IconFont.Pistol}"
                    FontFamily="IconFont"
                    Size="24"
                    Color="DarkSlateGray" />
            </ShellContent.Icon>
        </ShellContent>
    </TabBar>

</Shell>
