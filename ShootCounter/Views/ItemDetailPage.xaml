<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ShootCounter.Views.ItemDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="{Binding Title}"
    Shell.NavBarIsVisible="False">

    <VerticalStackLayout Padding="15" Spacing="3">
        <Label FontSize="Medium" Text="Text" />
        <Entry FontSize="Medium" Text="{Binding Text, Mode=TwoWay}" />
        <Label FontSize="Medium" Text="Description" />
        <Editor
            Margin="0"
            AutoSize="TextChanges"
            FontSize="Medium"
            Text="{Binding Description, Mode=TwoWay}" />
        <Button
            Command="{Binding SaveCommand}"
            HorizontalOptions="FillAndExpand"
            Text="Save" />
    </VerticalStackLayout>
</ContentPage>