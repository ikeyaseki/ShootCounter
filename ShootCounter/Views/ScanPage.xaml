<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             x:Class="ShootCounter.Views.ScanPage"
             Title="{Binding Title}">

    <Grid RowDefinitions="Auto,*,Auto,Auto,Auto" Padding="5">
        <Label Text="{Binding Title}" Style="{StaticResource CardTitle}" FontSize="20" Margin="7,10,7,8" Grid.Row="0" />

        <Grid Grid.Row="1">
            <skia:SKCanvasView x:Name="Canvas"
                               EnableTouchEvents="True"
                               PaintSurface="Canvas_PaintSurface"
                               Touch="Canvas_Touch" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
        </Grid>

        <Label Text="{Binding SummaryText}" Style="{StaticResource CardTitle}" FontSize="17" HorizontalOptions="Center" Margin="5,10,5,4" Grid.Row="2" />
        <Label Text="{Binding StatusText}" Style="{StaticResource SecondaryText}" HorizontalTextAlignment="Center" Margin="5,0,5,5" Grid.Row="3" />

        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Grid.Row="4" Margin="5,5,5,15">
            <Button Text="Abbrechen" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" Grid.Column="0" />
            <Button Text="Übernehmen" Command="{Binding AcceptCommand}" Style="{StaticResource PrimaryButton}" Grid.Column="1" />
        </Grid>
    </Grid>
</ContentPage>
