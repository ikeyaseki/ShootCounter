<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShootCounter.Views.WeaponsPage"
             xmlns:model="clr-namespace:ShootCounter.Models"
             xmlns:vm="clr-namespace:ShootCounter.ViewModels"
             xmlns:converter="clr-namespace:ShootCounter.Converter"
             xmlns:icons="clr-namespace:ShootCounter.Services"
             Title="{Binding Title}">

    <ContentPage.Resources>
        <converter:IsNotNullConverter x:Key="IsNotNullConverter" />
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem Command="{Binding AddWeaponCommand}" Text="Neu" />
    </ContentPage.ToolbarItems>

    <RefreshView Command="{Binding LoadWeaponsCommand}" IsRefreshing="{Binding IsBusy}">
        <CollectionView Margin="0,6,0,0" ItemsSource="{Binding Weapons}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="2" x:DataType="model:Weapon">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label Text="{x:Static icons:IconFont.Pistol}" Style="{StaticResource CardTitleIcon}" />
                                <Label Grid.Column="1" Text="{Binding DisplayName}" Style="{StaticResource CardTitle}" LineBreakMode="TailTruncation" />
                            </Grid>
                            <Label Style="{StaticResource SecondaryText}"
                                   Text="Ausgemustert"
                                   FontAttributes="Italic"
                                   Margin="0,4,0,0"
                                   IsVisible="{Binding IsRetired}" />
                            <Label Style="{StaticResource SecondaryText}"
                                   Margin="0,4,0,0"
                                   Text="{Binding PurchaseDate, StringFormat='Gekauft am {0:dd.MM.yyyy}'}"
                                   IsVisible="{Binding PurchaseDate, Converter={StaticResource IsNotNullConverter}}" />
                            <Label Style="{StaticResource BodyText}"
                                   Margin="0,4,0,0"
                                   Text="{Binding Notes}"
                                   MaxLines="2"
                                   LineBreakMode="TailTruncation"
                                   IsVisible="{Binding Notes, Converter={StaticResource IsNotNullConverter}}" />
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WeaponsViewModel}}, Path=WeaponTapped}"
                                    CommandParameter="{Binding .}" />
                            </VerticalStackLayout.GestureRecognizers>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <ContentView>
                    <VerticalStackLayout>
                        <Label Text="Noch keine Waffen erfasst. Tippe auf &quot;Neu&quot;, um eine zu erfassen." Margin="30,40" HorizontalTextAlignment="Center" Style="{StaticResource BodyText}" />
                    </VerticalStackLayout>
                </ContentView>
            </CollectionView.EmptyView>
        </CollectionView>
    </RefreshView>
</ContentPage>
