<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShootCounter.Views.TrainingDetailPage"
             xmlns:model="clr-namespace:ShootCounter.Models"
             xmlns:icons="clr-namespace:ShootCounter.Services"
             xmlns:converter="clr-namespace:ShootCounter.Converter"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
             Title="{Binding Title}">

    <ContentPage.Resources>
        <converter:DistanceTypeToStringConverter x:Key="DistanceTypeConverter" />
        <converter:DurationToStringConverter x:Key="DurationConverter" />
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem Command="{Binding DeleteCommand}" Text="Löschen" />
    </ContentPage.ToolbarItems>

    <ScrollView Orientation="Vertical">
        <Grid RowDefinitions="Auto,*">

            <Border Margin="5,10,5,10" 
                Stroke="DarkGray"
                StrokeThickness="2"
                Grid.Row="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <StackLayout Padding="10">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                          ColumnDefinitions="0.5*,0.5*">
                        <Label Style="{StaticResource TableHeader}" 
                               Text="{Binding Shooting.Location}"
                               Grid.Row="0"
                               Grid.ColumnSpan="2" />
                        <Label Style="{StaticResource TableContent}"
                               Text="{Binding Shooting.StartTime, StringFormat='{0:dd.MM.yyyy HH:mm}'}"
                               Grid.Row="1"
                               Grid.Column="0" />
                        <HorizontalStackLayout Grid.Row="1"
                                   Grid.Column="1">
                            <Label Style="{StaticResource TableContentIcon}"
                       Text="{x:Static icons:IconFont.ClockTimeNineOutline}" />
                            <Label Style="{StaticResource TableContent}"
                       Text="{Binding Shooting.Duration, Converter={StaticResource DurationConverter}}" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Grid.Row="2"
                                   Grid.Column="0">
                            <Label Style="{StaticResource TableContentIcon}"
                       Text="{x:Static icons:IconFont.MapMarkerDistance}" />
                            <Label Style="{StaticResource TableContent}"
                       Text="{Binding Shooting.DistanceType, Converter={StaticResource DistanceTypeConverter}}" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Grid.Row="2"
                                   Grid.Column="1">
                            <Label Style="{StaticResource TableContentIcon}"
                       Text="{x:Static icons:IconFont.Bullseye}" />
                            <Label Style="{StaticResource TableContent}"
                       Text="{Binding Shooting.TargetProperties.Name}" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Grid.Row="3"
                                   Grid.Column="0">
                            <Label Style="{StaticResource TableContentIcon}"
                       Text="{x:Static icons:IconFont.Pistol}" />
                            <Label Style="{StaticResource TableContent}"
                       Text="{Binding Shooting.Weapon}" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Grid.Row="3"
                                   Grid.Column="1">
                            <Label Style="{StaticResource TableContentIcon}"
                       Text="{x:Static icons:IconFont.Ammunition}" />
                            <Label Style="{StaticResource TableContent}"
                       Text="{Binding Shooting.BulletsPerRun}" />
                        </HorizontalStackLayout>
                        <BoxView HeightRequest="1"                                  
                     Color="DarkGray"
                     Margin="0,10"
                     Grid.Row="4"
                     Grid.ColumnSpan="2"/>
                        <HorizontalStackLayout Grid.Row="5"
                                   Grid.Column="0">
                            <Label Style="{StaticResource TableContentIcon}"
                       Text="{x:Static icons:IconFont.ArrowAll}" />
                            <Label Style="{StaticResource TableContentIcon}"
                       Text="{x:Static icons:IconFont.Ammunition}" />
                            <Label Style="{StaticResource TableContent}"
                       Text="{Binding Shooting.TotalBullets}" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Grid.Row="5"
                                   Grid.Column="1">
                            <Label Style="{StaticResource TableContentIcon}"
                       Text="{x:Static icons:IconFont.ArrowAll}" />
                            <Label Style="{StaticResource TableContentIcon}"
                       Text="{x:Static icons:IconFont.GiftOutline}" />
                            <Label Style="{StaticResource TableContent}"
                       Text="{Binding Shooting.MaxPoints}" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Grid.Row="6"
                                   Grid.Column="0">
                            <Label Style="{StaticResource TableContentIcon}"
                       Text="{x:Static icons:IconFont.Account}" />
                            <Label Style="{StaticResource TableContentIcon}"
                       Text="{x:Static icons:IconFont.PercentBoxOutline}" />
                            <Label Style="{StaticResource TableContent}"
                       Text="{Binding Shooting.TotalPercentage}" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Grid.Row="6"
                                   Grid.Column="1">
                            <Label Style="{StaticResource TableContentIcon}"
                       Text="{x:Static icons:IconFont.Account}" />
                            <Label Style="{StaticResource TableContentIcon}"
                       Text="{x:Static icons:IconFont.GiftOutline}" />
                            <Label Style="{StaticResource TableContent}"
                       Text="{Binding Shooting.TotalPoints}" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Grid.Row="7"
                                   Grid.Column="0">
                            <Label Style="{StaticResource TableContentIcon}"
                       Text="{x:Static icons:IconFont.ArrowDownBoldOutline}" />
                            <Label Style="{StaticResource TableContentIcon}"
                       Text="{x:Static icons:IconFont.Ammunition}" />
                            <Label Style="{StaticResource TableContent}"
                       Text="{Binding Shooting.BulletsZeroPoints}" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Grid.Row="7"
                                   Grid.Column="1">
                            <Label Style="{StaticResource TableContentIcon}"
                       Text="{x:Static icons:IconFont.ArrowUpBoldOutline}" />
                            <Label Style="{StaticResource TableContentIcon}"
                       Text="{x:Static icons:IconFont.Ammunition}" />
                            <Label Style="{StaticResource TableContent}"
                       Text="{Binding Shooting.BulletsMaxPoints}" />
                        </HorizontalStackLayout>
                    </Grid>
                </StackLayout>
            </Border>

            <lvc:CartesianChart
                ZoomMode="X"
                MinimumHeightRequest="400"
                Grid.Row="1">
                <lvc:CartesianChart Series="{Binding RunSeries}" XAxes="{Binding XAxes}"/>
            </lvc:CartesianChart>
        </Grid>
    </ScrollView>
</ContentPage>