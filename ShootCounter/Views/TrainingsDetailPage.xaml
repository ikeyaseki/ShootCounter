<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShootCounter.Views.TrainingDetailPage"
             xmlns:icons="clr-namespace:ShootCounter.Services"
             xmlns:views="clr-namespace:ShootCounter.Views"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
             Title="{Binding Title}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Command="{Binding DeleteCommand}" Text="Löschen" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="0,6,0,20">

            <Border Style="{StaticResource Card}">
                <views:TrainingSummaryView BindingContext="{Binding Shooting}" />
            </Border>

            <!-- points of each shot per run -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="6">
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="{x:Static icons:IconFont.Bullseye}" Style="{StaticResource CardTitleIcon}" />
                        <Label Text="Punkte pro Passe" Style="{StaticResource CardTitle}" />
                    </HorizontalStackLayout>
                    <lvc:CartesianChart BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}"
                                        ZoomMode="X"
                                        HeightRequest="360"
                                        Series="{Binding RunSeries}"
                                        XAxes="{Binding XAxes}"
                                        YAxes="{Binding YAxes}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
