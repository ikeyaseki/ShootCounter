<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShootCounter.Views.NewTrainingPage"
             xmlns:converter="clr-namespace:ShootCounter.Converter"
             Title="{Binding Title}">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" />
    </Shell.BackButtonBehavior>

    <ContentPage.Resources>
        <converter:DistanceTypeToStringConverter x:Key="DistanceTypeConverter" />
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem Command="{Binding CancelCommand}" Text="Cancel" />
        <ToolbarItem Command="{Binding SaveCommand}" Text="Continue" />
    </ContentPage.ToolbarItems>
    
    <VerticalStackLayout>
        <Label FontSize="Medium" Text="Location" />
        <Entry FontSize="Medium" 
               Text="{Binding Location, Mode=TwoWay}" 
               Keyboard="Text"/>
        <Label FontSize="Medium" Text="Distance" />
        <Picker Title="Select distance"
                ItemsSource="{Binding Distances}"
                ItemDisplayBinding="{Binding ., Converter={StaticResource DistanceTypeConverter}}"
                SelectedItem="{Binding SelectedDistance}" />
        <Label FontSize="Medium" Text="Target" />
        <Picker Title="Select target"
                ItemsSource="{Binding Targets}"
                ItemDisplayBinding="{Binding Name}"
                SelectedItem="{Binding SelectedTarget}" />
        <Label FontSize="Medium" Text="Weapon" />
        <Entry FontSize="Medium" 
               Text="{Binding Weapon, Mode=TwoWay}"
               Keyboard="Default"/>
        <Label FontSize="Medium" Text="Bullets per run" />
        <Entry FontSize="Medium" 
               Text="{Binding BulletsPerRun, Mode=TwoWay}"
               Keyboard="Numeric"/>
    </VerticalStackLayout>
</ContentPage>