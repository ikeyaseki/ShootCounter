<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShootCounter.Views.NewTrainingPage"
             xmlns:converter="clr-namespace:ShootCounter.Converter"
             Title="{Binding Title}">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsEnabled="False" IsVisible="False" />
    </Shell.BackButtonBehavior>

    <ContentPage.Resources>
        <converter:DistanceTypeToStringConverter x:Key="DistanceTypeConverter" />
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem Command="{Binding CancelCommand}" Text="Abbruch" />
        <ToolbarItem Command="{Binding SaveCommand}" Text="Weiter" />
    </ContentPage.ToolbarItems>
    
    <ScrollView>
        <VerticalStackLayout Padding="0,6,0,20">
        <Border Style="{StaticResource Card}">
            <VerticalStackLayout>
                <Label Style="{StaticResource FieldLabel}" Text="Ort" Margin="0" />
                <Entry FontSize="16" 
               Text="{Binding Location, Mode=TwoWay}" 
               Keyboard="Text"/>
                <Label Style="{StaticResource FieldLabel}" Text="Distanz" />
                <Picker FontSize="16" Title="Distanz wählen"
                ItemsSource="{Binding Distances}"
                ItemDisplayBinding="{Binding ., Converter={StaticResource DistanceTypeConverter}}"
                SelectedItem="{Binding SelectedDistance}" />
                <Label Style="{StaticResource FieldLabel}" Text="Scheibe" />
                <!-- the targets of the selected distance with a small picture, scrolls horizontally if they do not fit -->
                <CollectionView ItemsSource="{Binding Targets}"
                                SelectedItem="{Binding SelectedTarget, Mode=TwoWay}"
                                SelectionMode="Single"
                                ItemsLayout="HorizontalList"
                                HeightRequest="150"
                                Margin="0,5,0,5">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <!-- the selection is shown on the card, not as the platform's highlight of the whole item -->
                            <Grid Padding="3" BackgroundColor="Transparent">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup Name="CommonStates">
                                        <VisualState Name="Normal" />
                                        <VisualState Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="Transparent" />
                                                <Setter TargetName="Card" Property="Border.Stroke" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                                <Setter TargetName="Card" Property="Border.BackgroundColor" Value="{AppThemeBinding Light={StaticResource NoticeBackgroundLight}, Dark={StaticResource NoticeBackgroundDark}}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border x:Name="Card"
                                        Padding="6"
                                        WidthRequest="110"
                                        Stroke="{AppThemeBinding Light={StaticResource CardStrokeLight}, Dark={StaticResource CardStrokeDark}}"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource ChipBackgroundDark}}"
                                        StrokeThickness="2">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="4">
                                        <Image Source="{Binding Image}" HeightRequest="95" Aspect="AspectFit" />
                                        <Label Text="{Binding Name}" Style="{StaticResource TableContent}" FontSize="13" HorizontalOptions="Center" LineBreakMode="NoWrap" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <Label Style="{StaticResource FieldLabel}" Text="Waffe" />
                <Picker FontSize="16" Title="Waffe wählen"
                        ItemsSource="{Binding Weapons}"
                        ItemDisplayBinding="{Binding DisplayName}"
                        SelectedItem="{Binding SelectedWeapon}" />
                <Label Text="Keine aktive Waffe vorhanden. Lege sie zuerst im Tab &quot;Waffen&quot; an."
                       IsVisible="{Binding HasNoWeapons}"
                       Style="{StaticResource AccentText}" />
                <Label Style="{StaticResource FieldLabel}" Text="Schüsse pro Passe" />
                <Entry FontSize="16" 
               Text="{Binding BulletsPerRun, Mode=TwoWay}"
               Keyboard="Numeric"/>
            </VerticalStackLayout>
        </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>