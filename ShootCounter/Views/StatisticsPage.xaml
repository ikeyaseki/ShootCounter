<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShootCounter.Views.StatisticsPage"
             xmlns:icons="clr-namespace:ShootCounter.Services"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="0,6,0,20">

            <!-- filter -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout>
                    <HorizontalStackLayout Spacing="10" Margin="0,0,0,4">
                        <Label Text="{x:Static icons:IconFont.Details}" Style="{StaticResource CardTitleIcon}" />
                        <Label Text="Filter" Style="{StaticResource CardTitle}" />
                    </HorizontalStackLayout>
                    <Picker FontSize="16" Title="Zeitraum"
                            ItemsSource="{Binding Periods}"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding SelectedPeriod}" />
                    <Grid ColumnDefinitions="Auto,*,Auto,*" IsVisible="{Binding IsCustomPeriod}">
                        <Label Text="von" Style="{StaticResource RowName}" />
                        <DatePicker Grid.Column="1" Date="{Binding CustomFrom}" Format="dd.MM.yyyy" />
                        <Label Grid.Column="2" Text="bis" Margin="10,0,0,0" Style="{StaticResource RowName}" />
                        <DatePicker Grid.Column="3" Date="{Binding CustomTo}" Format="dd.MM.yyyy" />
                    </Grid>
                    <Picker FontSize="16" Title="Waffe"
                            ItemsSource="{Binding WeaponOptions}"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding SelectedWeapon}" />
                    <Picker FontSize="16" Title="Kaliber"
                            ItemsSource="{Binding CaliberOptions}"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding SelectedCaliber}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Für diesen Filter gibt es keine Trainings oder Wettkämpfe."
                   Style="{StaticResource BodyText}"
                   Margin="30,30"
                   HorizontalTextAlignment="Center"
                   IsVisible="{Binding IsEmpty}" />

            <VerticalStackLayout IsVisible="{Binding HasData}">

                <!-- key figures -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout>
                        <HorizontalStackLayout Spacing="10" Margin="0,0,0,8">
                            <Label Text="{x:Static icons:IconFont.PercentBoxOutline}" Style="{StaticResource CardTitleIcon}" />
                            <Label Text="Übersicht" Style="{StaticResource CardTitle}" />
                        </HorizontalStackLayout>
                        <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="15" RowSpacing="8">
                            <Label Grid.Column="1" Style="{StaticResource RowName}" Text="Training" HorizontalTextAlignment="End" FontSize="13" />
                            <Label Grid.Column="2" Style="{StaticResource RowName}" Text="Wettkampf" HorizontalTextAlignment="End" FontSize="13" />

                            <Label Grid.Row="1" Style="{StaticResource RowName}" Text="Anzahl" />
                            <Label Grid.Row="1" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding TrainingCount}" />
                            <Label Grid.Row="1" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding CompetitionCount}" />

                            <Label Grid.Row="2" Style="{StaticResource RowName}" Text="Schüsse" />
                            <Label Grid.Row="2" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding TrainingShots}" />
                            <Label Grid.Row="2" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding CompetitionShots}" />

                            <Label Grid.Row="3" Style="{StaticResource RowName}" Text="Ø Punkte" />
                            <Label Grid.Row="3" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding TrainingPercentage}" />
                            <Label Grid.Row="3" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding CompetitionPercentage}" />
                        </Grid>
                        <BoxView Style="{StaticResource Separator}" />
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Style="{StaticResource CardTitle}" Text="Schüsse total" FontSize="16" />
                            <Label Grid.Column="1" Text="{Binding TotalShots}"
                                   FontSize="24" FontAttributes="Bold" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- shots over time -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout>
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="{x:Static icons:IconFont.Ammunition}" Style="{StaticResource CardTitleIcon}" />
                            <Label Text="{Binding ChartTitle}" Style="{StaticResource CardTitle}" />
                        </HorizontalStackLayout>
                        <lvc:CartesianChart BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}"
                                            HeightRequest="260"
                                            Series="{Binding ShotSeries}"
                                            XAxes="{Binding XAxes}"
                                            YAxes="{Binding YAxes}"
                                            LegendPosition="Bottom"
                                            LegendTextPaint="{Binding LegendTextPaint}" />
                    </VerticalStackLayout>
                </Border>

                <!-- results over time -->
                <Border Style="{StaticResource Card}" IsVisible="{Binding HasTrend}">
                    <VerticalStackLayout>
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="{x:Static icons:IconFont.ArrowUpBoldOutline}" Style="{StaticResource CardTitleIcon}" />
                            <Label Text="Resultate im Verlauf" Style="{StaticResource CardTitle}" />
                        </HorizontalStackLayout>
                        <Label Style="{StaticResource Legend}" Text="{Binding TrendLegend}" Margin="0,2,0,0" />
                        <lvc:CartesianChart BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}"
                                            HeightRequest="280"
                                            Series="{Binding TrendSeries}"
                                            XAxes="{Binding TrendXAxes}"
                                            YAxes="{Binding TrendYAxes}"
                                            LegendPosition="Bottom"
                                            LegendTextPaint="{Binding LegendTextPaint}" />
                    </VerticalStackLayout>
                </Border>

                <!-- results per weapon -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout>
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="{x:Static icons:IconFont.Pistol}" Style="{StaticResource CardTitleIcon}" />
                            <Label Text="Resultate pro Waffe" Style="{StaticResource CardTitle}" />
                        </HorizontalStackLayout>
                        <Label Style="{StaticResource Legend}" Text="Ø Punkte in Prozent, in Klammern die Anzahl" Margin="0,2,0,4" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding WeaponResults}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout>
                                        <BoxView Style="{StaticResource Separator}" />
                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="2">
                                            <Label Style="{StaticResource RowValue}" Text="{Binding WeaponName}" FontAttributes="Bold" HorizontalTextAlignment="Start" />
                                            <Label Grid.Column="1" Style="{StaticResource SecondaryText}" Text="{Binding Shots, StringFormat='{0} Schüsse'}" VerticalOptions="Center" />
                                            <Label Grid.Row="1" Style="{StaticResource RowName}" Text="Training" />
                                            <Label Grid.Row="1" Grid.Column="1" Style="{StaticResource RowValue}" Text="{Binding Training}" />
                                            <Label Grid.Row="2" Style="{StaticResource RowName}" Text="Wettkampf" />
                                            <Label Grid.Row="2" Grid.Column="1" Style="{StaticResource RowValue}" Text="{Binding Competition}" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- shots per day -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="6">
                        <HorizontalStackLayout Spacing="10" Margin="0,0,0,4">
                            <Label Text="{x:Static icons:IconFont.ClockTimeNineOutline}" Style="{StaticResource CardTitleIcon}" />
                            <Label Text="Schüsse pro Tag" Style="{StaticResource CardTitle}" />
                        </HorizontalStackLayout>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Days}" Spacing="6">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Style="{StaticResource RowName}" Text="{Binding Label}" />
                                        <Label Grid.Column="1" Style="{StaticResource Value}" Text="{Binding TotalShots}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
