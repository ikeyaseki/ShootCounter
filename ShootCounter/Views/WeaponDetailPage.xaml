<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShootCounter.Views.WeaponDetailPage"
             Title="{Binding Title}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Command="{Binding RetireCommand}" Text="{Binding RetireText}" />
        <ToolbarItem Command="{Binding SaveCommand}" Text="Speichern" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="0,6,0,20">
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout>
                    <Label Style="{StaticResource FieldLabel}" Text="Hersteller" Margin="0" />
                    <Picker Title="Hersteller wählen" FontSize="16" ItemsSource="{Binding ManufacturerOptions}" SelectedItem="{Binding SelectedManufacturer}" />
                    <Entry FontSize="16" Text="{Binding Manufacturer, Mode=TwoWay}" Placeholder="Name des Herstellers" Keyboard="Text" IsVisible="{Binding IsOtherManufacturer}" />
                    <Label Style="{StaticResource FieldLabel}" Text="Modell" />
                    <Entry FontSize="16" Text="{Binding Model, Mode=TwoWay}" Keyboard="Text" />
                    <Label Style="{StaticResource FieldLabel}" Text="Kaliber" />
                    <Picker Title="Kaliber wählen" FontSize="16" ItemsSource="{Binding CaliberOptions}" SelectedItem="{Binding Caliber}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Style="{StaticResource RowValue}" Text="Kaufdatum bekannt" HorizontalTextAlignment="Start" />
                        <Switch Grid.Column="1" IsToggled="{Binding HasPurchaseDate, Mode=TwoWay}" />
                    </Grid>
                    <DatePicker FontSize="16"
                                Date="{Binding PurchaseDate, Mode=TwoWay}"
                                Format="dd.MM.yyyy"
                                IsVisible="{Binding HasPurchaseDate}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout>
                    <Label Style="{StaticResource FieldLabel}" Text="Notizen" Margin="0" />
                    <Editor FontSize="16" Text="{Binding Notes, Mode=TwoWay}" AutoSize="TextChanges" MinimumHeightRequest="100" Placeholder="z. B. Seriennummer, Visierung, Wartung" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Endgültig löschen"
                    Command="{Binding DeleteCommand}"
                    IsVisible="{Binding CanDelete}"
                    Style="{StaticResource DangerButton}"
                    Margin="12,14,12,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
