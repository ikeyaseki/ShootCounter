<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShootCounter.Views.WeaponDetailPage"
             Title="{Binding Title}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Command="{Binding RetireCommand}" Text="{Binding RetireText}" />
        <ToolbarItem Command="{Binding SaveCommand}" Text="Speichern" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <Border Margin="5,10,5,10"
                VerticalOptions="Start"
                Stroke="DarkGray"
                StrokeThickness="2">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>

            <VerticalStackLayout Padding="5">
                <Label FontSize="Medium" Text="Hersteller" />
                <Entry FontSize="Medium" Text="{Binding Manufacturer, Mode=TwoWay}" Keyboard="Text" />
                <Label FontSize="Medium" Text="Modell" />
                <Entry FontSize="Medium" Text="{Binding Model, Mode=TwoWay}" Keyboard="Text" />
                <Label FontSize="Medium" Text="Kaliber" />
                <Entry FontSize="Medium" Text="{Binding Caliber, Mode=TwoWay}" Placeholder="z. B. 9 mm Para" Keyboard="Text" />
                <HorizontalStackLayout>
                    <CheckBox IsChecked="{Binding HasPurchaseDate, Mode=TwoWay}" VerticalOptions="Center" />
                    <Label FontSize="Medium" Text="Kaufdatum bekannt" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <DatePicker FontSize="Medium"
                            Date="{Binding PurchaseDate, Mode=TwoWay}"
                            Format="dd.MM.yyyy"
                            IsEnabled="{Binding HasPurchaseDate}" />
                <Label FontSize="Medium" Text="Notizen" />
                <Editor FontSize="Medium" Text="{Binding Notes, Mode=TwoWay}" AutoSize="TextChanges" MinimumHeightRequest="100" />
                <Button Text="Endgültig löschen"
                        Command="{Binding DeleteCommand}"
                        IsVisible="{Binding CanDelete}"
                        BackgroundColor="DarkRed"
                        TextColor="White"
                        Margin="0,20,0,5" />
            </VerticalStackLayout>
        </Border>
    </ScrollView>
</ContentPage>
