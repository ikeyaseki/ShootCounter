<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShootCounter.Views.BulletScoringView"
             x:Name="Root">

    <!-- scoring of the bullets of one run, shows 5 bullets and scrolls horizontally for more -->
    <VerticalStackLayout>
        <Label x:Name="ScrollHint"
               IsVisible="False"
               FontSize="16"
               FontAttributes="Bold"
               TextColor="{StaticResource Primary}"
               HorizontalOptions="End"
               Margin="0,5,15,0" />

        <CollectionView x:Name="BulletList"
                        ItemsSource="{Binding Bullets}"
                        ItemsLayout="HorizontalList"
                        Scrolled="BulletList_Scrolled">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout Padding="0,10"
                                         WidthRequest="{Binding Source={x:Reference Root}, Path=ColumnWidth}">
                        <Label FontSize="16" Text="{Binding BulletNumber}" HorizontalOptions="Center" />
                        <!-- the radio buttons share this parent, so only one value per bullet can be checked -->
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Valuations}" HorizontalOptions="Center">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Content="{Binding Value}" Value="{Binding Value}" IsChecked="{Binding Hit}" CheckedChanged="RadioButton_CheckedChanged" Style="{StaticResource ToggleRadioStyle}" WidthRequest="60" Padding="5"/>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentView>
