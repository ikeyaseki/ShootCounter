<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShootCounter.Views.RunPage"
             xmlns:views="clr-namespace:ShootCounter.Views"
             Title="{Binding Title}">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsEnabled="False" IsVisible="False" />
    </Shell.BackButtonBehavior>

    <ContentPage.ToolbarItems>
        <ToolbarItem Command="{Binding AddBulletCommand}" Text="Schuss +" />
        <ToolbarItem Command="{Binding RemoveBulletCommand}" Text="Schuss -" />
    </ContentPage.ToolbarItems>

    <ScrollView Orientation="Vertical">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto">
            <views:BulletScoringView ValuationChanged="BulletScoring_ValuationChanged" Grid.Row="0" />

            <Button Text="Scheibe scannen" Command="{Binding ScanCommand}" IsVisible="{Binding IsScanAvailable}" Grid.Row="1" Margin="5"/>
            <Label FontSize="30" Text="{Binding Result}" HorizontalOptions="Center" Grid.Row="2"/>
            <Label FontSize="30" Text="{Binding Percent}" HorizontalOptions="Center" Grid.Row="3"/>
            <Button Text="Nächste Passe" Command="{Binding SaveCommand}" Grid.Row="4" Margin="5"/>
            <Button Text="Training beenden" Command="{Binding StopCommand}" Grid.Row="6" Margin="5,5,5,20"/>
        </Grid>
    </ScrollView>
</ContentPage>