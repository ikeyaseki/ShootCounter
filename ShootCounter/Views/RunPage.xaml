<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShootCounter.Views.RunPage"
             xmlns:views="clr-namespace:ShootCounter.Views"
             xmlns:converter="clr-namespace:ShootCounter.Converter"
             Title="{Binding Title}">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsEnabled="False" IsVisible="False" />
    </Shell.BackButtonBehavior>

    <ContentPage.Resources>
        <converter:IsNotNullConverter x:Key="IsNotNullConverter" />
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem Command="{Binding AddBulletCommand}" Text="Schuss +" />
        <ToolbarItem Command="{Binding RemoveBulletCommand}" Text="Schuss -" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="0,6,0,20">
            <Border Style="{StaticResource Card}" Padding="4,4,4,10">
                <views:BulletScoringView ValuationChanged="BulletScoring_ValuationChanged" />
            </Border>

            <Button Text="Scheibe scannen" Command="{Binding ScanCommand}" IsVisible="{Binding IsScanAvailable}" Style="{StaticResource SecondaryButton}" Margin="12,6" />

            <!-- result of the run, shown once a shot is scored -->
            <Border Style="{StaticResource Card}" IsVisible="{Binding Percent, Converter={StaticResource IsNotNullConverter}}">
                <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                    <Label Text="{Binding Percent}"
                           FontSize="40"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                    <Label Text="{Binding Result}" Style="{StaticResource BodyText}" FontSize="17" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Nächste Passe" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Margin="12,10,12,6" />
            <Button Text="Training beenden" Command="{Binding StopCommand}" Style="{StaticResource SecondaryButton}" Margin="12,6" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
