<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShootCounter.Views.RunPage"
             Title="{Binding Title}">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsEnabled="False" IsVisible="False" />
    </Shell.BackButtonBehavior>

    <ContentPage.ToolbarItems>
        <ToolbarItem Command="{Binding AddBulletCommand}" Text="Schuss +" />
        <ToolbarItem Command="{Binding RemoveBulletCommand}" Text="Schuss -" />
    </ContentPage.ToolbarItems>

    <ScrollView Orientation="Vertical">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
            <!-- wraps into a second row when the bullets do not fit the screen width -->
            <FlexLayout BindableLayout.ItemsSource="{Binding Bullets}" Wrap="Wrap" JustifyContent="Center" Grid.Row="0">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout Padding="10">
                            <Label FontSize="16" Text="{Binding BulletNumber}" />
                            <!-- the radio buttons share this parent, so only one value per bullet can be checked -->
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Valuations}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton Content="{Binding Value}" Value="{Binding Value}" IsChecked="{Binding Hit}" CheckedChanged="RadioButton_CheckedChanged" Style="{StaticResource ToggleRadioStyle}" WidthRequest="60" Padding="5"/>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

            <Label FontSize="30" Text="{Binding Result}" HorizontalOptions="Center" Grid.Row="1"/>
            <Label FontSize="30" Text="{Binding Percent}" HorizontalOptions="Center" Grid.Row="2"/>
            <Button Text="Nächste Passe" Command="{Binding SaveCommand}" Grid.Row="3" Margin="5"/>
            <Button Text="Training beenden" Command="{Binding StopCommand}" Grid.Row="5" Margin="5,5,5,20"/>
        </Grid>
    </ScrollView>
</ContentPage>