<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShootCounter.Views.RunPage"
             Title="{Binding Title}">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsEnabled="False" IsVisible="False" />
    </Shell.BackButtonBehavior>

    <ContentPage.Resources>
        <Style x:Key="ToggleRadioStyle" TargetType="RadioButton">
            <Setter Property="BackgroundColor" Value="LightGray" />
            <Setter Property="TextColor" Value="Black" />
            <Setter Property="Padding" Value="15" />
            <Setter Property="Margin" Value="0,5,0,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderColor" Value="Gray" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CheckedStates">
                        <VisualState x:Name="Checked">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{x:StaticResource Primary}" />
                                <Setter Property="TextColor" Value="White" />
                                <Setter Property="BorderColor" Value="DarkBlue" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Unchecked">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="LightGray" />
                                <Setter Property="TextColor" Value="Black" />
                                <Setter Property="BorderColor" Value="Gray" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem Command="{Binding AddBulletCommand}" Text="Schuss +" />
        <ToolbarItem Command="{Binding RemoveBulletCommand}" Text="Schuss -" />
    </ContentPage.ToolbarItems>

    <ScrollView Orientation="Vertical">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
            <CollectionView x:Name="BulletListView" 
                    ItemsSource="{Binding Bullets}" 
                    ItemsLayout="HorizontalList"
                    Grid.Row="0">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout Padding="10">
                            <Label FontSize="16" Text="{Binding BulletNumber}" />
                            <CollectionView ItemsSource="{Binding Valuations}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton Content="{Binding Value}" Value="{Binding Value}" IsChecked="{Binding Hit}" CheckedChanged="RadioButton_CheckedChanged" Style="{StaticResource ToggleRadioStyle}" WidthRequest="60" Padding="5"/>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label FontSize="30" Text="{Binding Result}" HorizontalOptions="Center" Grid.Row="1"/>
            <Label FontSize="30" Text="{Binding Percent}" HorizontalOptions="Center" Grid.Row="2"/>
            <Button Text="Next run" Command="{Binding SaveCommand}" Grid.Row="3" Margin="5"/>
            <Button Text="Stop shooting" Command="{Binding StopCommand}" Grid.Row="5" Margin="5"/>
        </Grid>
    </ScrollView>
</ContentPage>