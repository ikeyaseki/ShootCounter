<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShootCounter.Views.CompetitionsPage"
             xmlns:model="clr-namespace:ShootCounter.Models"
             xmlns:vm="clr-namespace:ShootCounter.ViewModels"
             xmlns:icons="clr-namespace:ShootCounter.Services"
             xmlns:views="clr-namespace:ShootCounter.Views"
             xmlns:helpers="clr-namespace:ShootCounter.Helpers"
             Title="{Binding Title}">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsEnabled="False" IsVisible="False" />
    </Shell.BackButtonBehavior>

    <ContentPage.ToolbarItems>
        <ToolbarItem Command="{Binding AddShootingCommand}" Text="Neu" />
        <ToolbarItem Command="{Binding DetailsCommand}" Text="Details" />
        <ToolbarItem Clicked="Legend_Clicked" Text="Legende">
            <ToolbarItem.IconImageSource>
                <FontImageSource Glyph="{x:Static icons:IconFont.InformationOutline}" FontFamily="IconFont" Size="24" Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>

    <Grid>
        <RefreshView Command="{Binding LoadShootingsCommand}" IsRefreshing="{Binding IsBusy}">
            <CollectionView x:Name="ShootingListView" ItemsSource="{Binding ShootingCompetitions}" SelectedItem="{Binding SelectedShootingCompetition}" SelectionMode="Single">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="model:ShootingCompetition">
                        <Border Style="{StaticResource SelectableCard}">
                            <views:CompetitionSummaryView>
                                <views:CompetitionSummaryView.GestureRecognizers>
                                    <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CompetitionsViewModel}}, Path=ShootingTapped}"
                                                CommandParameter="{Binding .}"
                                                NumberOfTapsRequired="2" />
                                    <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CompetitionsViewModel}}, Path=SelectionChangedCommand}"
                                                CommandParameter="{Binding .}"
                                                NumberOfTapsRequired="1" />
                                </views:CompetitionSummaryView.GestureRecognizers>
                            </views:CompetitionSummaryView>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <ContentView>
                        <VerticalStackLayout>
                            <Label Text="Noch keine Wettkämpfe vorhanden. Tippe auf &quot;Neu&quot;, um einen zu starten." Margin="30,40" HorizontalTextAlignment="Center" Style="{StaticResource BodyText}" />
                        </VerticalStackLayout>
                    </ContentView>
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>

        <!-- legend of the icons, opened with the info button in the toolbar -->
        <views:LegendOverlay x:Name="Legend" Items="{x:Static helpers:Legends.Competition}" />
    </Grid>

</ContentPage>