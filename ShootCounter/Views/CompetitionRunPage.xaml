<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShootCounter.Views.CompetitionRunPage"
             Title="{Binding Title}">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsEnabled="False" IsVisible="False" />
    </Shell.BackButtonBehavior>

    <ContentPage.Resources>
        <Style x:Key="ToggleRadioStyle" TargetType="RadioButton">
            <Setter Property="BackgroundColor" Value="LightGray" />
            <Setter Property="TextColor" Value="Black" />
            <Setter Property="Padding" Value="15" />
            <Setter Property="Margin" Value="0,5,0,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderColor" Value="Gray" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CheckedStates">
                        <VisualState x:Name="Checked">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{x:StaticResource Primary}" />
                                <Setter Property="TextColor" Value="White" />
                                <Setter Property="BorderColor" Value="DarkBlue" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Unchecked">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="LightGray" />
                                <Setter Property="TextColor" Value="Black" />
                                <Setter Property="BorderColor" Value="Gray" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem Command="{Binding StopCommand}" Text="Abbruch" />
    </ContentPage.ToolbarItems>
    

    <ScrollView Orientation="Vertical">
        <VerticalStackLayout>

            <VerticalStackLayout IsVisible="True">
                <Label Text="{Binding Shooting.CompetitionProperties.Name}" 
                       FontSize="Medium"
                       FontAttributes="Bold"
                       Margin="15,0,0,0"/>
                <Label Text="{Binding PasseString}"
                       FontSize="Medium"
                       Margin="15,0,0,0" />
            </VerticalStackLayout>

            <VerticalStackLayout IsVisible="True">
                <Label Text="Info"
                       FontSize="Medium"
                       FontAttributes="Bold"
                       Margin="15,20,0,0" />
                <Label Text="Dieser Wettkampf erlaubt Probeschüsse. Schiesse diese selbständig bevor du die erste Passe startest."
                       FontSize="Medium"
                       Margin="15,10,0,0" />
                <Label Text="Die Schüsse dieser Passe werden einzeln gezeigt."
                       FontSize="Medium"
                       Margin="15,10,0,0" />
                <Label Text="Lade 1 Patrone und starte die Passe."
                       FontSize="Medium"
                       Margin="15,10,0,0"/>
            </VerticalStackLayout>
            
            <VerticalStackLayout IsVisible="{Binding ShowTargetValuations}">
                <CollectionView x:Name="BulletListView" 
                ItemsSource="{Binding Bullets}" 
                ItemsLayout="HorizontalList">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <VerticalStackLayout Padding="10">
                                <Label FontSize="16" Text="{Binding BulletNumber}" />
                                <CollectionView ItemsSource="{Binding Valuations}">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <RadioButton Content="{Binding Value}" Value="{Binding Value}" IsChecked="{Binding Hit}" CheckedChanged="RadioButton_CheckedChanged" Style="{StaticResource ToggleRadioStyle}" WidthRequest="60" Padding="5"/>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <Button Text="Weiter" Command="{Binding ContinueCommand}" Margin="5" />

            <Button Text="Next run" Command="{Binding SaveCommand}" Margin="5"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>