<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShootCounter.Views.NewCompetitionPage"
             xmlns:converter="clr-namespace:ShootCounter.Converter"
             xmlns:icons="clr-namespace:ShootCounter.Services"
             Title="{Binding Title}">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsEnabled="False" IsVisible="False" />
    </Shell.BackButtonBehavior>

    <ContentPage.Resources>
        <converter:CompetitionTypeToInfoStringConverter x:Key="CompetitonTypeConverter" />
        <converter:IsNotNullConverter x:Key="IsNotNullConverter" />
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem Command="{Binding CancelCommand}" Text="Abbruch" />
        <ToolbarItem Command="{Binding SaveCommand}" Text="Weiter" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="0,6,0,20">
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout>
                    <Label Style="{StaticResource FieldLabel}" Text="Ort" Margin="0" />
                    <Entry FontSize="16"
                           Text="{Binding Location, Mode=TwoWay}"
                           Keyboard="Text"/>
                    <Label Style="{StaticResource FieldLabel}" Text="Stich" />
                    <Picker FontSize="16" Title="Wettkampf wählen"
                            ItemsSource="{Binding Competitions}"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding SelectedCompetition}" />
                    <Label Style="{StaticResource FieldLabel}" Text="Waffe" />
                    <Picker FontSize="16" Title="Waffe wählen"
                            ItemsSource="{Binding Weapons}"
                            ItemDisplayBinding="{Binding DisplayName}"
                            SelectedItem="{Binding SelectedWeapon}" />
                    <Label Text="Keine aktive Waffe vorhanden. Lege sie zuerst im Tab &quot;Waffen&quot; an."
                           IsVisible="{Binding HasNoWeapons}"
                           Style="{StaticResource AccentText}" />
                </VerticalStackLayout>
            </Border>

            <!-- the rules of the chosen competition -->
            <Border Style="{StaticResource NoticeCard}" IsVisible="{Binding SelectedCompetition, Converter={StaticResource IsNotNullConverter}}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Label Text="{x:Static icons:IconFont.InformationOutline}"
                           Style="{StaticResource CardTitleIcon}"
                           FontSize="24"
                           VerticalOptions="Start" />
                    <Label Grid.Column="1"
                           Text="{Binding SelectedCompetition.CompetitionType, Converter={StaticResource CompetitonTypeConverter}}"
                           LineBreakMode="WordWrap"
                           FontSize="15"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                </Grid>
            </Border>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
