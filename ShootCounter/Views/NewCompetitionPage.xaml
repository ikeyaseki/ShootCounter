<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShootCounter.Views.NewCompetitionPage"
             xmlns:converter="clr-namespace:ShootCounter.Converter"
             Title="{Binding Title}">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsEnabled="False" IsVisible="False" />
    </Shell.BackButtonBehavior>

    <ContentPage.Resources>
        <converter:CompetitionTypeToInfoStringConverter x:Key="CompetitonTypeConverter" />
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem Command="{Binding CancelCommand}" Text="Abbruch" />
        <ToolbarItem Command="{Binding SaveCommand}" Text="Weiter" />
    </ContentPage.ToolbarItems>

    <VerticalStackLayout>
        <Border Margin="5,10,5,10" 
                Stroke="DarkGray"
                StrokeThickness="2">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>

            <StackLayout Padding="5">
                <Label FontSize="Medium" Text="Ort" />
                <Entry FontSize="Medium" 
                       Text="{Binding Location, Mode=TwoWay}" 
                       Keyboard="Text"/>
                <Label FontSize="Medium" Text="Stich" />
                <Picker Title="Wettkampf wählen"
                        ItemsSource="{Binding Competitions}"
                        ItemDisplayBinding="{Binding Name}"
                        SelectedItem="{Binding SelectedCompetition}" />
                <Label FontSize="Medium" Text="Waffe" />
                <Picker Title="Waffe wählen"
                        ItemsSource="{Binding Weapons}"
                        ItemDisplayBinding="{Binding DisplayName}"
                        SelectedItem="{Binding SelectedWeapon}" />
                <Label Text="Keine aktive Waffe vorhanden. Lege sie zuerst im Tab &quot;Waffen&quot; an."
                       IsVisible="{Binding HasNoWeapons}"
                       TextColor="{StaticResource Primary}" />
            </StackLayout>
        </Border>

        <Label Text="{Binding SelectedCompetition.CompetitionType, Converter={StaticResource CompetitonTypeConverter}}"
               LineBreakMode="WordWrap"
               FontSize="Medium"
               FontAttributes="None"
               Margin="15,20,15,0" />
    </VerticalStackLayout>
        
</ContentPage>